# Redis
REDIS_URL=redis://192.168.100.128:6379/0

# LLM Providers（选填你需要的）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

CLAUDE_API_KEY=sk-ant-your-claude-key
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_MODEL=claude-sonnet-4-20250514

DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-chat

# 阿里云 Embedding（固定用这个，独立于上面三个 LLM provider）
ALIYUN_EMBEDDING_API_KEY=sk-b64ea752aefb42c39769cee69b5006c8
ALIYUN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_EMBEDDING_MODEL=text-embedding-v3



CHUNK_SIZE=500
CHUNK_OVERLAP=50
SEARCH_TOP_K=5
